# Server (never prefix service keys with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Local browser login only. Must stay off in Vercel Production.
HB_DEV_LOGIN=1

# Toss login / unlink / IAP / ads / push
TOSS_CLIENT_CERT_BASE64=
TOSS_CLIENT_KEY_BASE64=
TOSS_DECRYPTION_KEY=
TOSS_AAD=
TOSS_UNLINK_BASIC_AUTH=
# Leave empty to use the official test rewarded ad id (ait-ad-test-rewarded-id).
TOSS_REWARDED_AD_GROUP_ID=
TOSS_PUSH_AVAILABLE_TEMPLATE=
TOSS_PUSH_REPLY_TEMPLATE=
TOSS_IAP_PRODUCTS={"honsulbar_p1000":{"points":1000,"won":1100},"honsulbar_p3300":{"points":3300,"won":3300},"honsulbar_p6000":{"points":6000,"won":5500},"honsulbar_p10000":{"points":10000,"won":8800},"honsulbar_p20000":{"points":20000,"won":16500}}
TOSS_SUBSCRIPTION_SKU=honsulbar_sub_monthly
# Optional. If set, also paste the same username:password into the Toss IAP payment notification Basic Auth field.
TOSS_IAP_BASIC_AUTH=

# Admin + mail + cron
