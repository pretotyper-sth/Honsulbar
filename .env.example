# Server (never prefix service keys with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Local browser login only. Must stay off in Vercel Production.
HB_DEV_LOGIN=1

# Toss login / unlink / IAP / ads / push
TOSS_CLIENT_CERT_BASE64=
TOSS_CLIENT_KEY_BASE64=
TOSS_DECRYPTION_KEY=
TOSS_AAD=
TOSS_UNLINK_BASIC_AUTH=
# Production default is ait.v2.live.2b2d1c7fbd1a451b. Local/dev can use ait-ad-test-rewarded-id.
TOSS_REWARDED_AD_GROUP_ID=ait.v2.live.2b2d1c7fbd1a451b
# AppsInToss console → workspace → 키. Used by npm run toss:build / toss:release.
AIT_API_KEY=
TOSS_PUSH_AVAILABLE_TEMPLATE=
TOSS_PUSH_REPLY_TEMPLATE=
TOSS_IAP_PRODUCTS={"ait.0000078228.10e9c057.abb16a92b7.0232936136":{"points":1000,"won":1100},"ait.0000078228.6ec058de.36dbc34bc4.0233037038":{"points":3300,"won":3300},"ait.0000078228.f9cd1a54.c3649ea495.0233080906":{"points":6000,"won":5500},"ait.0000078228.fd822515.cc48bf218d.0233160336":{"points":10000,"won":8800},"ait.0000078228.8b1b9cbd.8529f22c7a.0233188045":{"points":20000,"won":16500}}
TOSS_SUBSCRIPTION_SKU=sub.1od0.muf71ewh.de9ba197b4
# Optional. If set, also paste the same username:password into the Toss IAP payment notification Basic Auth field.
TOSS_IAP_BASIC_AUTH=

# Admin + mail + cron
ADMIN_EMAILS=pretotyper.sth@gmail.com
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=혼술바 <noreply@YOUR_DOMAIN>
CRON_SECRET=
