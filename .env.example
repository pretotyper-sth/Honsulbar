# Future shared production API. Current local-test build overrides this with localhost.
VITE_API_BASE=https://honsulbar-app.vercel.app
# No server/service-role key belongs in the Android app.
# Native SDKs are installed; server credentials are never bundled into the app.

# Public OAuth build configuration (no service-role key)
# Enable only after Kakao/Google providers are configured in Supabase Auth.
HB_SOCIAL_LOGIN_ENABLED=0
HB_AUTH_PUBLIC_URL=
HB_AUTH_PUBLIC_KEY=
# Shared API server only: stable independent secret, minimum 32 characters
HB_IDENTITY_HASH_KEY=

# Actual integration build (no mock login, photo bypass, purchase/subscription grants)
# HB_ANDROID_MODE=integration
# HB_ANDROID_API_URL=https://YOUR_VERIFIED_API_HOST
# HB_AUTH_PUBLIC_URL=https://YOUR_PROJECT.supabase.co
# HB_AUTH_PUBLIC_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Server only. Keep checkout locked until license testers are registered in Play.
HB_PLAY_PACKAGE_NAME=com.honsulbar.app
HB_PLAY_BILLING_MODE=test
HB_PLAY_LICENSE_TESTERS_CONFIRMED=0
HB_PLAY_TEST_MEMBER_IDS=
HB_PLAY_SERVICE_ACCOUNT_JSON=

# Server-only FCM sender credentials; no billing account or Cloud Functions required.
HB_FCM_ENABLED=0
HB_FCM_PROJECT_ID=noted-processor-513409-r5
HB_FCM_SERVICE_ACCOUNT_JSON=
# Client switch. Requires matching android/app/google-services.json (ignored by git).
HB_ANDROID_PUSH_ENABLED=0

# Server-only reward verification. Disabled unless explicitly configured.
HB_ANDROID_ADS_MODE=off
HB_ANDROID_TEST_MEMBER_IDS=
HB_ADMOB_REWARD_UNIT_ID=
# AdMob SSV URL: https://honsulbar-app.vercel.app/api/admob-ssv
