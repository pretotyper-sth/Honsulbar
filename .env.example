# Future shared production API. Current local-test build overrides this with localhost.
VITE_API_BASE=https://honsulbar-app.vercel.app
# No server/service-role key belongs in the Android app.
# OAuth, Play Billing, AdMob and FCM settings will be added when accounts are configured.

# Public OAuth build configuration (no service-role key)
# Enable only after Kakao/Google providers are configured in Supabase Auth.
HB_SOCIAL_LOGIN_ENABLED=0
HB_AUTH_PUBLIC_URL=
HB_AUTH_PUBLIC_KEY=
# Shared API server only: stable independent secret, minimum 32 characters
HB_IDENTITY_HASH_KEY=

# Actual integration build (no mock login, photo bypass, purchase/subscription grants)
# HB_ANDROID_MODE=integration
# HB_ANDROID_API_URL=https://YOUR_VERIFIED_API_HOST
# HB_AUTH_PUBLIC_URL=https://YOUR_PROJECT.supabase.co
# HB_AUTH_PUBLIC_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
